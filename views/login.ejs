<%- include('partials/header') %>
<%- include('partials/navbar', {page: '/login'}) %>
<link href="https://cdn.jsdelivr.net/npm/daisyui@3.9.4/dist/full.css" rel="stylesheet">

<main class="container mx-auto p-4">
  <div class="hero bg-base-200 rounded-lg p-6 mb-6">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-5xl font-bold">Login</h1>
      </div>
    </div>
  </div>

  <% if (errorMessage) { %>
    <div class="alert alert-error mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= errorMessage %></span>
    </div>
  <% } %>

  <div class="card bg-base-100 shadow-xl mx-auto max-w-md">
    <div class="card-body">
      <form method="POST" action="/login">
        <div class="form-control">
          <label class="label">
            <span class="label-text">User Name</span>
          </label>
          <input type="text" name="userName" placeholder="User Name" class="input input-bordered" required value="<%= userName %>" />
        </div>
        <div class="form-control">
          <label class="label">
            <span class="label-text">Password</span>
          </label>
          <input type="password" name="password" placeholder="Password" class="input input-bordered" required />
        </div>
        <div class="form-control mt-6">
          <button type="submit" class="btn btn-primary">Login</button>
        </div>
      </form>
    </div>
  </div>
</main>

