<%- include('partials/header') %>
<%- include('partials/navbar', {page: '/userHistory'}) %>
<link href="https://cdn.jsdelivr.net/npm/daisyui@3.9.4/dist/full.css" rel="stylesheet">
<main class="container mx-auto p-4">
  <div class="hero bg-base-200 rounded-lg p-6 mb-6">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-5xl font-bold">User History</h1>
        <p class="py-2">User: <%= session.user.userName %></p>
        <p class="py-2">Email: <%= session.user.email %></p>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Login Date/Time</th>
          <th>Client Information</th>
        </tr>
      </thead>
      <tbody>
        <% session.user.loginHistory.forEach(history => { %>
          <tr>
            <td><%= history.dateTime %></td>
            <td><%= history.userAgent %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

